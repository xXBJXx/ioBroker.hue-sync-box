{
  "name": "iobroker.hue-sync-box",
  "version": "0.4.0",
  "description": "Securely discover, monitor and control Philips Hue Play HDMI Sync Boxes",
  "author": {
    "name": "Issi",
    "email": "issi.dev.iobroker@gmail.com"
  },
  "homepage": "https://github.com/xXBJXx/ioBroker.hue-sync-box",
  "license": "MIT",
  "keywords": ["iobroker", "philips", "hue", "lighting", "sync", "hdmi"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xXBJXx/ioBroker.hue-sync-box.git"
  },
  "bugs": {
    "url": "https://github.com/xXBJXx/ioBroker.hue-sync-box/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "build/main.js",
  "workspaces": ["src-admin"],
  "files": ["admin/", "build/", "io-package.json", "LICENSE", "README.md"],
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/dm-utils": "^3.2.0",
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/dev-server": "https://codeload.github.com/xXBJXx/dev-server/tar.gz/c0338ae",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "clean": "rimraf build admin/assets admin/index.html admin/tab.html",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:admin": "npm --workspace src-admin run build",
    "build": "npm run clean && npm run build:ts && npm run build:admin",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --workspace src-admin run typecheck",
    "lint": "eslint src test --max-warnings 0 && npm --workspace src-admin run lint",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:package": "mocha test/package.js --exit",
    "test:integration": "mocha test/integration.js --exit",
    "test": "npm run test:unit && npm run test:package",
    "test:hardware": "vitest run --config test/hardware/vitest.config.ts",
    "dev-server": "dev-server",
    "dev": "dev-server watch",
    "release": "release-script"
  }
}
